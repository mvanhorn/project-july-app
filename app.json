{
  "expo": {
    "name": "Project July",
    "slug": "project-july",
    "scheme": "julyoven",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#faf6ef",
    "ios": {
      "bundleIdentifier": "org.projectjuly.oven",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Project July talks to your June oven over your home Wi-Fi.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "org.projectjuly.oven",
      "adaptiveIcon": {
        "backgroundColor": "#faf6ef",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#faf6ef",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#17130f"
          }
        }
      ],
      "expo-image",
      "expo-web-browser",
      "./plugins/withLocalNetwork",
      "./plugins/withLocalReleaseSigning",
      "./plugins/withWindowsNativeBuild",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Project July saves pictures from your oven camera to Photos when you ask.",
          "granularPermissions": ["photo"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "51fab44b-d449-4ebd-86d6-f4d5fe09846a"
      }
    },
    "owner": "fixitfelixs-team",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/51fab44b-d449-4ebd-86d6-f4d5fe09846a",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
